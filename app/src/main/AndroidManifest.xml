<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN"/>
      <category android:name="android.intent.category.LAUNCHER"/>
    </intent>
  </queries>
  <application android:label="Mollad DNS" android:icon="@mipmap/ic_dark" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name=".MainActivity" android:exported="false" android:label="Mollad DNS"/>
    <activity-alias android:name=".DarkAlias" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true" android:label="Mollad DNS" android:icon="@mipmap/ic_dark">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity-alias>
    <activity-alias android:name=".LightAlias" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:label="Mollad DNS" android:icon="@mipmap/ic_light">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity-alias>
    <!-- Creates the VPNJantit account in the background (own process, so the VPN stays safe if the WebView crashes) -->
    <service android:name=".VjService" android:process=":vj" android:exported="false"/>
    <!-- Receives status lines and results from the :vj process -->
    <receiver android:name=".VjBridge" android:exported="false"><intent-filter><action android:name="app.sd.VJ_STATUS"/><action android:name="app.sd.VJ_RESULT"/></intent-filter></receiver>
    <receiver android:name=".VjReceiver" android:exported="false"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/></intent-filter></receiver>
    <service android:name=".VpnSvc" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter><action android:name="android.net.VpnService"/></intent-filter>
    </service>
  </application>
</manifest>
